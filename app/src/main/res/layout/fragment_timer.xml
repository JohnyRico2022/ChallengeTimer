        app:layout_constraintTop_toTopOf="parent" />-->


    <ru.nikita.challengetimer.customView.CircularTimerView
        android:id="@+id/timerView"
        android:layout_width="320dp"
        android:layout_height="320dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPassedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Уже прошло"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/timerView"
        app:layout_constraintStart_toStartOf="@+id/timerView"
        app:layout_constraintTop_toBottomOf="@+id/timerView" />

    <TextView
        android:id="@+id/tvPassedValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:text="0д 00:00:00"
        android:textColor="#000000"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="@+id/timerView"
        app:layout_constraintStart_toStartOf="@+id/timerView"
        app:layout_constraintTop_toBottomOf="@+id/tvPassedLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>